# Plantilla de nginx. La imagen oficial sustituye ${RUTA_WEB} al arrancar.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    absolute_redirect off;
    server_tokens off;

    # La web no es pública: ni buscadores ni contenido incrustado en otras webs.
    add_header X-Robots-Tag "noindex, nofollow" always;

    location = ${RUTA_WEB} {
        return 301 ${RUTA_WEB}/;
    }

    location ${RUTA_WEB}/ {
        auth_basic "AD Vega Norte - TFM";
        auth_basic_user_file /etc/nginx/htpasswd;
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/index.html $uri.html =404;

        # Ficheros con huella en el nombre: se pueden guardar mucho tiempo.
        location ${RUTA_WEB}/_astro/ {
            add_header X-Robots-Tag "noindex, nofollow" always;
            add_header Cache-Control "public, max-age=31536000, immutable" always;
        }
    }

    error_page 404 ${RUTA_WEB}/404.html;
}
