---
// Portada PROVISIONAL (bloque 1). Los bloques 1-6 de inicio.md se montan en el bloque 2.
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const inicio = await getEntry('paginas', 'inicio');
if (!inicio) throw new Error('Falta contenido/paginas/inicio.md');
const { titulo, descripcion } = inicio.data;
---

<Base titulo={titulo} descripcion={descripcion} portada>
  <section class="seccion">
    <div class="contenedor">
      <h1>{titulo}</h1>
      <p>{descripcion}</p>
    </div>
  </section>
</Base>
