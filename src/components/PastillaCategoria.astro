---
// Etiqueta de categoría de una noticia: pastilla granate, Oswald 500, texto blanco.
// Muestra el equipo si existe (p. ej. «Alevín A») y, si no, la categoría.
interface Props {
  texto: string;
}

const { texto } = Astro.props;
---

<span class="pastilla">{texto}</span>

<style>
  .pastilla {
    display: inline-block;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--vn-granate);
    color: var(--vn-blanco);
    font-family: var(--vn-fuente-titulo);
    font-weight: 500;
    font-size: 14px;
    line-height: 20px;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }
</style>
