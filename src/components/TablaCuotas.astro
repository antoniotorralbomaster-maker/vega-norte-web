---
// Tabla de cuotas (bloque 15). Lee `categorias` y `cuotas` de datos/club.json.
// Una fila por categoría y nivel de equipo: la mensualidad y los pagos dependen del equipo.
import { club } from '../lib/datos';
import { filasCuotas } from '../lib/categorias';
import { euros } from '../lib/formato';

interface Props {
  nota?: string;
}

const { nota } = Astro.props;
const { matricula, temporada } = club.cuotas;
const filas = filasCuotas();
---

<figure class="tabla-figura">
<div class="tabla-marco" role="region" aria-label={`Cuotas de la temporada ${temporada}`} tabindex="0">
  <table class="tabla">
    <thead>
      <tr>
        <th scope="col">Categoría</th>
        <th scope="col">Equipos</th>
        <th scope="col" class="num">Matrícula</th>
        <th scope="col" class="num">Mensualidad</th>
        <th scope="col" class="num">Pagos</th>
        <th scope="col" class="num">Total</th>
      </tr>
    </thead>
    <tbody>
      {
        filas.map((f) => (
          <tr>
            <th scope="row">{f.categoria}</th>
            <td>{f.equipos}</td>
            <td class="num">{euros(matricula)}</td>
            <td class="num">{euros(f.mensualidad)}</td>
            <td class="num">{f.pagos}</td>
            <td class="num">{euros(f.total)}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
  {nota && <figcaption>{nota}</figcaption>}
</figure>
