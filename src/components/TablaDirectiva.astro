---
// Directiva del club (bloque 7). Lee `directiva` de datos/club.json. Adultos ficticios.
import { club } from '../lib/datos';

interface Props {
  pie?: string;
}

const { pie } = Astro.props;
---

<figure class="tabla-figura">
<div class="tabla-marco" role="region" aria-label="Directiva del club" tabindex="0">
  <table class="tabla tabla--estrecha tabla--compacta">
    <thead>
      <tr>
        <th scope="col">Cargo</th>
        <th scope="col">Nombre</th>
      </tr>
    </thead>
    <tbody>
      {
        club.directiva.map((d) => (
          <tr>
            <th scope="row">{d.cargo}</th>
            <td>{d.nombre}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
  {pie && <figcaption>{pie}</figcaption>}
</figure>
