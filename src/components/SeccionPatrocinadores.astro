---
// Patrocinadores (bloque 6): todos los de datos/club.json, el principal primero.
// Cada tarjeta muestra su logo y, si existe, la imagen del anuncio (src/assets/patrocinadores).
import { Image } from 'astro:assets';
import { patrocinadoresFranja, club } from '../lib/datos';
import { imagenPatrocinador } from '../lib/patrocinadores';
import { url } from '../lib/url';
import type { Enlace } from '../lib/secciones';

interface Props {
  enlace?: Enlace;
}

const { enlace } = Astro.props;
const patrocinadores = patrocinadoresFranja(club.patrocinadores.length);
---

<ul class="patro">
  {
    patrocinadores.map((p) => (
      <li class:list={['patro__item', { 'patro__item--principal': p.nivel === 'Principal' }]}>
        {imagenPatrocinador(p.nombre, 'imagen') && (
          <Image src={imagenPatrocinador(p.nombre, 'imagen')!} alt="" width={800} class="patro__foto" />
        )}
        <span class="patro__cabecera">
          {imagenPatrocinador(p.nombre, 'logo') && (
            <Image src={imagenPatrocinador(p.nombre, 'logo')!} alt="" height={112} class="patro__logo" />
          )}
          <span class="patro__textos">
            <span class="patro__nivel texto-pequeno">{p.nivel}</span>
            <span class="patro__nombre">{p.nombre}</span>
          </span>
        </span>
        <span class="patro__desc texto-pequeno">{p.descripcion}</span>
      </li>
    ))
  }
</ul>
{
  enlace && (
    <p class="patro__accion">
      <a class="boton boton--secundario" href={url(enlace.ruta)}>
        {enlace.texto}
      </a>
    </p>
  )
}

<style>
  .patro {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media (min-width: 600px) {
    .patro {
      grid-template-columns: repeat(3, 1fr);
    }

    .patro__item--principal {
      grid-column: 1 / -1;
    }
  }

  .patro__item {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1.25rem;
    background: var(--vn-blanco);
    border: 1px solid var(--vn-arena);
    border-radius: 4px;
  }

  .patro__item--principal {
    border: 2px solid var(--vn-rojo);
  }

  .patro__foto {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 16px;
    margin-bottom: 0.75rem;
  }

  .patro__cabecera {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .patro__textos {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .patro__logo {
    height: 56px;
    width: auto;
    flex: none;
  }

  .patro__nivel {
    color: var(--vn-gris);
  }

  .patro__nombre {
    font-weight: 600;
    font-size: 20px;
    line-height: 28px;
    color: var(--vn-carbon);
  }

  .patro__item--principal .patro__nombre {
    font-size: 24px;
    line-height: 32px;
    color: var(--vn-granate);
  }

  .patro__accion {
    margin: 1.5rem 0 0;
  }
</style>
