---
// Franja inferior en rojo: lema y hasta 3 logos de patrocinadores (Manual de identidad).
// Lee de datos/club.json. Mientras no haya logos, cada patrocinador se muestra
// como un marcador con su nombre (sustituir por <img> cuando existan los ficheros).
import { club, patrocinadoresFranja } from '../lib/datos';

const patrocinadores = patrocinadoresFranja(3);
---

<section class="franja sobre-rojo" aria-labelledby="franja-lema">
  <div class="contenedor franja__interior">
    <p id="franja-lema" class="franja__lema titular">{club.club.lema}</p>
    <ul class="franja__logos" aria-label="Patrocinadores">
      {
        patrocinadores.map((p) => (
          <li class="franja__logo" data-nivel={p.nivel}>
            <span class="franja__nombre">{p.nombre}</span>
            <span class="solo-lectores">, patrocinador {p.nivel.toLowerCase()}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .franja__interior {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    padding-block: 1.5rem;
  }

  .franja__lema {
    font: var(--vn-h3);
    letter-spacing: 0.01em;
    margin: 0;
  }

  .franja__logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .franja__logo {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    min-width: 9rem;
    padding: 0.5rem 1rem;
    border: 2px solid var(--vn-blanco);
    border-radius: 4px;
    text-align: center;
  }

  .franja__nombre {
    font-weight: 600;
    font-size: 16px;
    line-height: 20px;
  }

  @media (max-width: 599px) {
    .franja__logos {
      width: 100%;
    }

    .franja__logo {
      flex: 1 1 100%;
    }
  }
</style>
